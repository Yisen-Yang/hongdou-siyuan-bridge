{
  "manifest_version": 2,
  "name": "Hongdou SiYuan Bridge",
  "version": "0.3.1",
  "description": "把红豆（Zotero 内核）里的文献一键推送到思源笔记：条目上右键「发送到思源」，经 6 位配对码鉴权，本地推送完整元数据与 PDF 路径，思源端自动落笔。仅走 127.0.0.1，不联网。",
  "author": "Yisen-Yang",
  "homepage_url": "https://github.com/Yisen-Yang/hongdou-siyuan-bridge",
  "icons": {
    "48": "chrome/content/icon.png",
    "96": "chrome/content/icon.png"
  },
  "applications": {
    "zotero": {
      "id": "hongdou-siyuan-bridge@yisen-yang.github.io",
      "update_url": "https://github.com/Yisen-Yang/hongdou-siyuan-bridge/releases/latest/download/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    },
    "com.inoteexpress.hongdou": {
      "strict_min_version": "7.9.9",
      "strict_max_version": "10.9.9"
    }
  }
}
